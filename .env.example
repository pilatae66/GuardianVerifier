# Guardian Verification System Configuration

# Environment
NODE_ENV=development

# App Configuration
REACT_APP_NAME=Guardian Verification System
REACT_APP_VERSION=1.0.0

# Database
DATABASE_PATH=./guardian-system.db

# Scanner Configuration
SCANNER_TIMEOUT=5000
SCANNER_FRAME_RATE=10
SCANNER_BOX_SIZE=250

# Debug Mode
DEBUG=false
