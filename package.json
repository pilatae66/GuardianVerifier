{
  "name": "guardian-verification-system",
  "version": "1.0.0",
  "author": "Guardian Verification Team",
  "description": "Guardian Verification System using Electron, React, and barcode scanning",
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "axios": "^1.3.0",
    "electron-is-dev": "^2.0.0",
    "express": "^4.18.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.2.3",
    "jspdf": "^2.5.1",
    "react": "^18.2.0",
    "react-csv": "^2.2.2",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "sql.js": "^1.8.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-devtools-installer": "^3.2.0",
    "react-scripts": "5.0.1",
    "wait-on": "^7.0.1"
  },
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron-start": "electron .",
    "electron-dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run react-build && electron-builder",
    "build": "npm run react-build",
    "start": "npm run electron-dev",
    "dev": "npm run electron-dev",
    "test-build": "npm run react-build",
    "prod-build": "npm run electron-build",
    "prod-build-win": "npm run react-build && electron-builder --win",
    "prod-build-mac": "npm run react-build && electron-builder --mac",
    "prod-build-linux": "npm run react-build && electron-builder --linux",
    "dist": "npm run electron-build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.guardianverification.app",
    "productName": "Guardian Verification System",
    "files": [
      "build/**/*",
      "public/**/*",
      "database.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "asar": true,
      "asarUnpack": ["build/**/*"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
